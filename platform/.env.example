# Copy to .env and fill in only the providers you want.
# The app works with NO keys (offline rule-based agent).

# Local, free & unlimited (recommended). Run: ollama serve && ollama pull llama3.2
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Free-tier cloud providers (optional). Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
